# 默认云端提供商为 DeepSeek。复制为 .env 后，在本地填写你自备的 DeepSeek 密钥。
# API Key 留空时不启用模型，也不会自动调用 API。不要把 Gemini 密钥用于 DeepSeek。
# 字段名、问题及另行确认的部分查询结果可能包含敏感信息。
DATAPILOT_API_KEY=
# 不包含 /chat/completions，程序自动追加。Gemini/其他兼容接口仍可显式配置。
DATAPILOT_BASE_URL=https://api.deepseek.com
DATAPILOT_MODEL=deepseek-flash
# DeepSeek 官方接口固定发送 max_tokens 和 thinking.type=disabled。
# 其他提供商可按其文档改用 max_completion_tokens。
DATAPILOT_TOKEN_PARAMETER=max_tokens
# 不支持 response_format 的服务可显式改为 prompt，仍必须返回符合业务结构的 JSON。
DATAPILOT_JSON_MODE=json_object
# 范围 128 至 2048。此项限制输出，不代表金额硬上限。
DATAPILOT_MAX_OUTPUT_TOKENS=1200
